# ==============================================================================
# STRATRADE PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC CLIENT ENVIRONMENT VARIABLES (Bundled into frontend app)
# NEVER put secret keys or bot tokens under VITE_ prefixes!
# ------------------------------------------------------------------------------

# Supabase Project URL & Anon Public Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Google Gemini AI Key (Client/Sandbox Mode)
VITE_GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# SERVER-ONLY / BACKEND SECRETS (Never exposed to browser bundle)
# Configure these in Supabase Edge Function Secrets, Vercel/Netlify Env, or backend server.
# ------------------------------------------------------------------------------

# Telegram Bot Token (Used by Supabase Edge Function: send-telegram-alert)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase Service Role Key (Admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
